# Client-side (Vite-injected, shipped to the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side (same values, unprefixed — read via process.env in server
# functions and middleware; must be set even though they duplicate the
# VITE_ vars above)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-side only — service role key, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (checkout is skipped with a "not configured" response until this is set)
STRIPE_SECRET_KEY=
